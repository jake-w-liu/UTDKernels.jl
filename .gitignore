# Generated documentation and plots.
/docs/build/
/examples/figs/*
!/examples/figs/.gitkeep
/paper/figs/*
!/paper/figs/.gitkeep
/validation/figs/*
!/validation/figs/.gitkeep
textbook_figs
.DS_Store

# Root package manifests are local resolver output. The dedicated docs,
# examples, paper, and validation environments keep their own manifests.
/Manifest.toml
/Manifest-v*.toml

# Generated datasets (regenerated by the scripts; not tracked in any format).
/paper/data/*
!/paper/data/.gitkeep
/validation/data/*
!/validation/data/.gitkeep
